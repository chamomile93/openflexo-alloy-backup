    <eoperations name="getDefinition" etype="ecore:EClass platform:/plugin/fr.irisa.triskell.kermeta.io/src/kermeta/framework.ecore#/2/standard/String">
      <eannotations source="kermeta">
        <details key="body" value="do
	var alloyModelString : kermeta::standard::String init &quot;&quot;
	if self.isVoid.~not then
		if self.module.isVoid.~not then
			alloyModelString := ((self.module.getDefinition) + (&quot;\n\n&quot;))

		end
		if self.paragraphs.isVoid.~not then
			self.paragraphs.each{paragraph | do
					if paragraph.isInstanceOf(Cartier::AlloyMM::OpenDecl) then
						alloyModelString := ((((alloyModelString) + (paragraph.getDefinition))) + (&quot;\n\n&quot;))

					end
				end}
			self.paragraphs.each{paragraph | do
					if paragraph.isInstanceOf(Cartier::AlloyMM::EnumDecl) then
						alloyModelString := ((alloyModelString) + (paragraph.getDefinition))

					end
				end}
			self.paragraphs.each{paragraph | do
					if paragraph.isInstanceOf(Cartier::AlloyMM::SigDecl) then
						alloyModelString := ((alloyModelString) + (paragraph.getDefinition))

					end
				end}
			self.paragraphs.each{paragraph | do
					if paragraph.isInstanceOf(Cartier::AlloyMM::FactDecl) then
						alloyModelString := ((alloyModelString) + (paragraph.getDefinition))

					end
				end}
			self.paragraphs.each{paragraph | do
					if paragraph.isInstanceOf(Cartier::AlloyMM::FunDecl) then
						alloyModelString := ((alloyModelString) + (paragraph.getDefinition))

